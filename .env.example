# ============================================================================
# LLM Configuration — Choose ONE of the options below
# ============================================================================

# OPTION A: Ollama (Local LLM) — RECOMMENDED FOR LEARNING
# Setup: Download from https://ollama.ai, run 'ollama serve'
# Then: ollama pull mistral
# Benefits: Free, Private, Offline, No API keys needed
# Models: mistral, llama2, neural-chat, dolphin-mixtral, etc.
# 
OLLAMA_MODEL=mistral:latest
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama

# OPTION B: LLMStudio (GUI for Local LLMs)
# Setup: Download from https://lmstudio.ai, enable "Local Server"
# Then configure like Ollama above with your loaded model
#
# OLLAMA_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=not-needed

# OPTION C: OpenAI (Cloud LLM) — Production
# Setup: Get API key from https://platform.openai.com/account/api-keys
# Docs: https://platform.openai.com/docs/models
#
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OLLAMA_BASE_URL=https://api.openai.com/v1
# OLLAMA_MODEL=gpt-4o-mini  # or gpt-3.5-turbo, gpt-4o, etc.

# OPTION D: Other Cloud Providers (Anthropic, Google, etc.)
# See https://python.langchain.com/docs/integrations/llms/
# You may need to modify utils/llm_client.py for these

# LLM Behavior Configuration
LLM_TEMPERATURE=0.7          # 0.0 (deterministic) to 2.0 (creative)
LLM_MAX_TOKENS=512           # Maximum response length in tokens

# ============================================================================
# Observability & Monitoring (Optional)
# ============================================================================

# LangSmith — Official LangChain Tracing
# Setup: Create account at https://smith.langchain.com
# Benefits: See all LLM calls, latency, token usage, debug traces
# Docs: https://docs.smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=qubika-study

# LangFuse — Alternative/Additional Analytics
# Setup: Create account at https://cloud.langfuse.com
# Benefits: Detailed analytics, cost tracking, A/B testing
# Docs: https://langfuse.com/docs
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# ============================================================================
# Vector Databases
# ============================================================================

# Chroma — Local Vector DB (Default, No Setup Required)
# Benefits: Free, local, perfect for development
CHROMA_PATH=./data/chroma

# Pinecone — Cloud Vector DB (Optional, for Production)
# Setup: Create account at https://www.pinecone.io
# Benefits: Managed service, scales to billions of vectors
# Docs: https://docs.pinecone.io/
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Additional LLM Providers (Optional)
# ============================================================================

# HuggingFace Token (for using HF models/embeddings)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Debugging & Logging
# ============================================================================

DEBUG=false
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
